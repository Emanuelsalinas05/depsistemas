# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_NAME="Sistema de Gestión de Desarrollos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# En producción detrás de HTTPS / balanceador: true
APP_FORCE_HTTPS=false

# Solo con HTTPS real terminado en el cliente (no activar en http://)
FORCE_HSTS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------------------------------------
# Seguridad y proxies
# -----------------------------------------------------------------------------
# Lista separada por comas de IPs de balanceadores, o * para confiar en todos
# (útil detrás de WAF/proxy corporativo; endurecer a IPs fijas cuando sea posible).
TRUSTED_PROXIES=*

# Registro público: en APP_ENV=production queda deshabilitado por defecto.
# En local puede forzarse: DISABLE_REGISTRATION=true|false
# DISABLE_REGISTRATION=false

# -----------------------------------------------------------------------------
# Autenticación
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Base de datos (MySQL 8 recomendado en institucional)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=depsistemas
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesión y caché
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# En producción institucional se recomienda true si el driver lo soporta.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# Redis (opcional; recomendado para colas y caché en producción)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Semillas (NUNCA activar datos demo en producción)
# -----------------------------------------------------------------------------
# Solo local/staging: crear usuarios y proyecto demo (credenciales débiles).
SEED_DEMO_DATA=false

# Usuario inicial (producción o primer arranque). Eliminar INITIAL_ADMIN_PASSWORD del .env tras uso.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Administrador del sistema"
# INITIAL_ADMIN_UPDATE_PASSWORD=false

# -----------------------------------------------------------------------------
# AWS / S3 (opcional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
